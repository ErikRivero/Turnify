    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Turnify.Core\Turnify.Core.csproj" />
  </ItemGroup>

